
{{> head}}
<body class="bg-gray-100 min-h-screen">

  <div class="flex min-h-screen">

    <!-- Sidebar -->
    <aside class="w-64 bg-slate-900 text-white p-6 hidden md:block">
      <h1 class="text-2xl font-bold text-yellow-400 mb-2">StaffPay</h1>
      <p class="text-gray-400 text-sm mb-10">Management Portal</p>

      <nav class="space-y-3">
        <a href="/dashboard" class="block px-4 py-3 rounded-lg hover:bg-slate-700">
          Dashboard
        </a>

        <a href="/employees" class="block px-4 py-3 rounded-lg bg-yellow-500 text-slate-900 font-semibold">
          Employee Management
        </a>

        <a href="/manager-attendance" class="block px-4 py-3 rounded-lg hover:bg-slate-700">
          Attendance
        </a>

        <a href="/logout" class="block px-4 py-3 rounded-lg hover:bg-red-600 mt-10">
          Logout
        </a>
      </nav>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 p-6 md:p-10">

      <div class="mb-8">
        <h2 class="text-3xl font-bold text-slate-900">Register New Employee</h2>
        <p class="text-gray-500 mt-2">
          Register employee information and create their StaffPay login account.
        </p>
      </div>

      <form action="/add-employee" method="POST"
            class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 max-w-3xl">

        <!-- Employee Information -->
        <h3 class="text-xl font-bold text-slate-900 mb-2">
          Employee Information
        </h3>
        <p class="text-gray-500 text-sm mb-5">
          Enter the employee's personal and employment details.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Employee Code</label>
            <input type="text" name="employee_code" placeholder="e.g. EMP002"
                   class="w-full p-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-yellow-400"
                   required>
          </div>

          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Position</label>
            <input type="text" name="position" placeholder="e.g. Cashier"
                   class="w-full p-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-yellow-400"
                   required>
          </div>

          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">First Name</label>
            <input type="text" name="first_name" placeholder="Enter first name"
                   class="w-full p-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-yellow-400"
                   required>
          </div>

          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Last Name</label>
            <input type="text" name="last_name" placeholder="Enter last name"
                   class="w-full p-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-yellow-400"
                   required>
          </div>

          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Contact Number</label>
            <input type="text" name="contact_number" placeholder="09XXXXXXXXX"
                   class="w-full p-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-yellow-400"
                   required>
          </div>

          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Daily Rate (₱)</label>
            <input type="number" name="daily_rate" placeholder="500.00"
                   min="0.01" step="0.01"
                   class="w-full p-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-yellow-400"
                   required>
          </div>

        </div>

        <hr class="my-8">

        <!-- Staff Login Information -->
        <h3 class="text-xl font-bold text-slate-900 mb-2">
          Staff Login Information
        </h3>
        <p class="text-gray-500 text-sm mb-5">
          Create the employee's account credentials.
        </p>

        <div class="space-y-5">

          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Email Address</label>
            <input type="email" name="email" placeholder="employee@example.com"
                   class="w-full p-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-yellow-400"
                   required>
          </div>

          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Password</label>
            <input type="password" name="password" placeholder="Minimum 8 characters"
                   minlength="8"
                   class="w-full p-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-yellow-400"
                   required>
            <p class="text-xs text-gray-500 mt-2">
              Password must contain at least 8 characters.
            </p>
          </div>

        </div>

        <div class="flex flex-col sm:flex-row gap-3 mt-8">
          <button type="submit"
                  class="bg-yellow-500 hover:bg-yellow-400 text-slate-900 font-bold px-6 py-3 rounded-lg">
            Register Employee & Create Account
          </button>

          <a href="/employees"
             class="text-center bg-slate-200 hover:bg-slate-300 text-slate-800 font-semibold px-6 py-3 rounded-lg">
            Cancel
          </a>
        </div>

      </form>

      <footer class="mt-10 text-center text-gray-400 text-sm">
        © 2026 StaffPay | Restaurant Staff Attendance and Payroll Management System
      </footer>

    </main>
  </div>

</body>
</html>
