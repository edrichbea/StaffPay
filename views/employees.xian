
{{> head}}

<body class="bg-slate-100 min-h-screen">

  <div class="max-w-7xl mx-auto p-6 md:p-10">

    <!-- HEADER -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-8">
      <div>
        <p class="text-amber-600 font-bold text-sm uppercase tracking-wider">
          StaffPay Management
        </p>
        <h1 class="text-3xl font-bold text-slate-800 mt-1">
          Employee Management
        </h1>
        <p class="text-slate-500 mt-2">
          Manage registered restaurant employees and their information.
        </p>
      </div>

      <a href="/dashboard"
         class="bg-slate-800 hover:bg-slate-700 text-white px-5 py-3 rounded-lg text-center font-semibold">
        Back to Dashboard
      </a>
    </div>

    <!-- REGISTER BUTTON -->
    <div class="mb-8">
      <a href="/add-employee"
         class="block bg-amber-500 hover:bg-amber-600 text-slate-900 p-5 rounded-xl shadow-sm font-bold text-center transition">
        <span class="block text-lg">+ Register New Employee</span>
        <span class="block text-sm font-normal mt-1">
          Add employee information and create Staff login account
        </span>
      </a>
    </div>

    <!-- EMPLOYEE TABLE -->
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">

      <div class="p-6 border-b border-slate-200">
        <h2 class="text-xl font-bold text-slate-800">
          Registered Employees
        </h2>
        <p class="text-sm text-slate-500 mt-1">
          Employee information and current employment status.
        </p>
      </div>

      <div class="overflow-x-auto">

        <table class="w-full text-sm text-left">

          <thead class="bg-slate-800 text-white uppercase text-xs">
            <tr>
              <th class="px-5 py-4">Employee Code</th>
              <th class="px-5 py-4">First Name</th>
              <th class="px-5 py-4">Last Name</th>
              <th class="px-5 py-4">Position</th>
              <th class="px-5 py-4">Contact Number</th>
              <th class="px-5 py-4">Daily Rate</th>
              <th class="px-5 py-4">Status</th>
            </tr>
          </thead>

          <tbody class="divide-y divide-slate-100">

            {{#each employees}}

            <tr class="hover:bg-slate-50 transition">

              <td class="px-5 py-4 font-semibold text-slate-800">
                {{this.employee_code}}
              </td>

              <td class="px-5 py-4 text-slate-600">
                {{this.first_name}}
              </td>

              <td class="px-5 py-4 text-slate-600">
                {{this.last_name}}
              </td>

              <td class="px-5 py-4 text-slate-600">
                {{this.position}}
              </td>

              <td class="px-5 py-4 text-slate-600">
                {{this.contact_number}}
              </td>

              <td class="px-5 py-4 font-semibold text-slate-800">
                ₱{{this.daily_rate}}
              </td>

              <td class="px-5 py-4">
                {{#if (eq this.employment_status "active")}}
                <span class="bg-green-100 text-green-700 px-3 py-1 rounded-full text-xs font-bold">
                  Active
                </span>
                {{else}}
                <span class="bg-red-100 text-red-700 px-3 py-1 rounded-full text-xs font-bold">
                  Inactive
                </span>
                {{/if}}
              </td>

            </tr>

            {{else}}

            <tr>
              <td colspan="7" class="px-5 py-10 text-center text-slate-400">
                No employees registered yet.
              </td>
            </tr>

            {{/each}}

          </tbody>

        </table>

      </div>
    </div>

    <!-- FOOTER -->
    <footer class="text-center text-sm text-slate-400 mt-10">
      © 2026 StaffPay — RestoFlow. All rights reserved.
    </footer>

  </div>

</body>
</html>
