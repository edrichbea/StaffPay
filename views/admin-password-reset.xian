
{{> head}}

<body class="min-h-screen bg-gray-100">

  <div class="max-w-4xl mx-auto px-4 py-10">

    <div class="mb-8">
      <a href="/dashboard" class="text-sm text-yellow-700 font-semibold">
        ← Back to Dashboard
      </a>

      <h1 class="text-3xl font-extrabold text-slate-900 mt-4">
        Admin Password Reset
      </h1>

      <p class="text-gray-500 mt-2">
        Directly reset a Manager or Staff account password.
      </p>
    </div>

    <div class="bg-white rounded-2xl shadow-lg border border-gray-200 overflow-hidden">

      <div class="bg-slate-900 px-8 py-6">
        <h2 class="text-xl font-bold text-white">
          Reset Employee Password
        </h2>

        <p class="text-sm text-gray-300 mt-2">
          Select an account and assign a new password.
        </p>
      </div>

      <div class="p-8">

        <form method="POST" action="/admin/password-reset">

          <div class="mb-6">
            <label class="block text-sm font-semibold text-slate-700 mb-2">
              Select Employee Account
            </label>

            <select
              name="user_id"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-yellow-500"
              required
            >
              <option value="">-- Select Account --</option>

              {{#each users}}
                <option value="{{this.id}}">
                  {{this.name}} - {{this.email}} ({{this.role}})
                </option>
              {{/each}}

            </select>
          </div>

          <div class="mb-6">
            <label class="block text-sm font-semibold text-slate-700 mb-2">
              New Password
            </label>

            <input
              type="password"
              name="password"
              minlength="8"
              placeholder="Enter new password"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-yellow-500"
              required
            >
          </div>

          <div class="mb-8">
            <label class="block text-sm font-semibold text-slate-700 mb-2">
              Confirm New Password
            </label>

            <input
              type="password"
              name="confirm_password"
              minlength="8"
              placeholder="Confirm new password"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-yellow-500"
              required
            >
          </div>

          <button
            type="submit"
            class="w-full bg-yellow-500 hover:bg-yellow-600 text-slate-900 font-bold py-3 rounded-lg shadow-md"
          >
            RESET ACCOUNT PASSWORD
          </button>

        </form>

      </div>
    </div>

    <div class="mt-6 bg-yellow-50 border border-yellow-200 rounded-lg p-4">
      <p class="text-sm text-yellow-900">
        <strong>Admin Notice:</strong>
        Only authorized administrators can use this feature.
        Make sure the selected account belongs to the correct employee.
      </p>
    </div>

  </div>

{{> footer }}
</body>
</html>
