
{{> head}}

<body class="bg-slate-100 min-h-screen">

  <div class="max-w-7xl mx-auto p-6 md:p-10">

    <!-- HEADER -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-8">
      <div>
        <p class="text-amber-600 font-bold text-sm uppercase tracking-wider">
          StaffPay Administration
        </p>
        <h1 class="text-3xl font-bold text-slate-800 mt-1">
          Create Manager Account
        </h1>
        <p class="text-slate-500 mt-2">
          Register a manager who can manage employee attendance.
        </p>
      </div>

      <a href="/dashboard"
         class="bg-slate-800 hover:bg-slate-700 text-white px-5 py-3 rounded-lg text-center font-semibold">
        Back to Dashboard
      </a>
    </div>

    <!-- ACCOUNT FORM -->
    <div class="max-w-2xl mx-auto bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">

      <div class="bg-slate-800 p-6">
        <h2 class="text-xl font-bold text-white">
          Manager Account Information
        </h2>
        <p class="text-sm text-slate-300 mt-1">
          Complete the required information to create a manager account.
        </p>
      </div>

      <form action="/create-manager-account" method="POST"
            class="p-6 space-y-5">

        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-2">
            Manager Name
          </label>
          <input
            type="text"
            name="name"
            placeholder="Enter manager name"
            required
            class="w-full border border-slate-300 rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-amber-400"
          >
        </div>

        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-2">
            Email Address
          </label>
          <input
            type="email"
            name="email"
            placeholder="Enter manager email"
            required
            class="w-full border border-slate-300 rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-amber-400"
          >
        </div>

        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-2">
            Password
          </label>
          <input
            type="password"
            name="password"
            placeholder="At least 8 characters"
            minlength="8"
            required
            class="w-full border border-slate-300 rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-amber-400"
          >
          <p class="text-xs text-slate-400 mt-2">
            Password must contain at least 8 characters.
          </p>
        </div>

        <div class="pt-3">
          <button
            type="submit"
            class="w-full bg-amber-500 hover:bg-amber-600 text-slate-900 p-3 rounded-lg font-bold transition"
          >
            Create Manager Account
          </button>
        </div>

      </form>
    </div>

    <footer class="text-center text-sm text-slate-400 mt-10">
      © 2026 StaffPay — RestoFlow. All rights reserved.
    </footer>

  </div>

</body>
</html>
