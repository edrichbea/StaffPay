
{{> head}}

<body class="min-h-screen bg-gray-100">

  <div class="min-h-screen flex items-center justify-center px-4 py-10">

    <div class="w-full max-w-md">

      <div class="text-center mb-8">
        <div class="inline-flex items-center justify-center w-16 h-16 bg-yellow-500 rounded-2xl mb-4">
          <span class="text-3xl font-bold text-slate-900">S</span>
        </div>

        <h1 class="text-3xl font-extrabold text-slate-900">
          Staff<span class="text-yellow-600">Pay</span>
        </h1>

        <p class="text-sm text-gray-500 mt-2">
          Account Security
        </p>
      </div>

      <div class="bg-white rounded-2xl shadow-xl border border-gray-200 overflow-hidden">

        <div class="bg-slate-900 px-8 py-8 text-center">

          <div class="w-20 h-20 bg-yellow-500 rounded-full flex items-center justify-center mx-auto mb-5">
            <span class="text-5xl font-bold text-slate-900">
              ✓
            </span>
          </div>

          <h2 class="text-2xl font-extrabold text-white">
            Password Reset
            <span class="text-yellow-400">Successful!</span>
          </h2>

          <p class="text-sm text-gray-300 mt-3">
            Your password has been updated successfully.
          </p>

        </div>

        <div class="p-8 text-center">

          <p class="text-gray-600 mb-6 leading-relaxed">
            You can now access your StaffPay account using your new password.
            Keep your password secure and do not share it with anyone.
          </p>

          <a
            href="/login"
            class="block w-full bg-yellow-500 hover:bg-yellow-600 text-slate-900 font-bold py-3 rounded-lg shadow-md transition"
          >
            GO TO LOGIN
          </a>

          <p class="text-xs text-gray-400 mt-6">
            Your account security matters to us.
          </p>

        </div>
      </div>

      <div class="text-center mt-6">
        <p class="text-xs text-gray-500">
          © 2026 StaffPay | RestoFlow System
        </p>
      </div>

    </div>
  </div>

{{> footer }}
</body>
</html>
