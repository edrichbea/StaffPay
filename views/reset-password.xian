
{{> head}}

<body class="min-h-screen bg-gray-100">

  <div class="min-h-screen flex items-center justify-center px-4 py-10">
    <div class="w-full max-w-md">

      <div class="text-center mb-8">
        <div class="inline-flex items-center justify-center w-16 h-16 bg-yellow-500 rounded-2xl mb-4">
          <span class="text-3xl font-bold text-slate-900">S</span>
        </div>

        <h1 class="text-3xl font-extrabold text-slate-900">
          Staff<span class="text-yellow-600">Pay</span>
        </h1>

        <p class="text-sm text-gray-500 mt-2">
          Password Recovery
        </p>
      </div>

      <div class="bg-white rounded-2xl shadow-xl border border-gray-200 overflow-hidden">

        <div class="bg-slate-900 px-8 py-6 text-center">
          <h2 class="text-2xl font-bold text-white">
            Create New Password
          </h2>

          <p class="text-sm text-gray-300 mt-2">
            Enter your new password below.
          </p>
        </div>

        <div class="p-8">

          <form method="POST" action="/forgot-password/reset-password">

            <div class="mb-5">
              <label class="block text-sm font-semibold text-slate-700 mb-2">
                New Password
              </label>

              <input
                type="password"
                name="password"
                minlength="8"
                placeholder="Enter new password"
                class="w-full px-4 py-3 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-yellow-500"
                required
              >
            </div>

            <div class="mb-6">
              <label class="block text-sm font-semibold text-slate-700 mb-2">
                Confirm New Password
              </label>

              <input
                type="password"
                name="confirm_password"
                minlength="8"
                placeholder="Confirm new password"
                class="w-full px-4 py-3 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-yellow-500"
                required
              >
            </div>

            <button
              type="submit"
              class="w-full bg-yellow-500 hover:bg-yellow-600 text-slate-900 font-bold py-3 rounded-lg shadow-md"
            >
              RESET PASSWORD
            </button>

          </form>

        </div>
      </div>

      <div class="text-center mt-6">
        <a href="/login" class="text-sm text-gray-500">
          ← Back to Login
        </a>
      </div>

      <div class="text-center mt-6">
        <p class="text-xs text-gray-500">
          © 2026 StaffPay | RestoFlow System
        </p>
      </div>

    </div>
  </div>

{{> footer }}
</body>
</html>
