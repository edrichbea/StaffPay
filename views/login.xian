{{> head}}

<body class="min-h-screen bg-slate-100">

  <div class="min-h-screen flex items-center justify-center px-4 py-10">
    <div class="w-full max-w-md">

      <!-- StaffPay Branding -->
      <div class="text-center mb-8">
        <div class="inline-flex items-center justify-center w-16 h-16 bg-yellow-500 rounded-2xl mb-4 shadow-lg">
          <span class="text-3xl font-bold text-slate-900">S</span>
        </div>

        <h1 class="text-3xl font-extrabold text-slate-900">
          Staff<span class="text-yellow-600">Pay</span>
        </h1>

        <p class="text-gray-500 text-sm mt-2">
          Restaurant Staff Attendance and Payroll Management System
        </p>
      </div>

      <!-- Login Card -->
      <div class="bg-white rounded-2xl shadow-xl border border-gray-200 overflow-hidden">

        <div class="bg-slate-900 px-8 py-6 text-center">
          <h2 class="text-2xl font-bold text-white">Welcome Back</h2>
          <p class="text-gray-300 text-sm mt-2">
            Sign in to access your account
          </p>
        </div>

        <div class="p-8">

          <form method="POST" action="/login" class="flex flex-col gap-5">

            <!-- Email -->
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-2">
                Email Address
              </label>

              <input
                type="email"
                name="email"
                placeholder="Enter your email"
                class="w-full px-4 py-3 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-yellow-500"
                required
              />
            </div>

            <!-- Password -->
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-2">
                Password
              </label>

              <div class="flex border border-gray-300 rounded-lg overflow-hidden">
                <input
                  type="password"
                  id="password"
                  name="password"
                  placeholder="Enter your password"
                  class="w-full px-4 py-3 outline-none"
                  required
                />

                <button
                  type="button"
                  id="togglePassword"
                  class="px-4 bg-gray-100 text-yellow-700 font-semibold hover:bg-gray-200"
                >
                  Show
                </button>
              </div>
            </div>

            <!-- Forgot Password -->
            <div class="text-right -mt-3">
              <a
                href="/forgot-password"
                class="text-sm text-yellow-700 hover:text-yellow-800 font-semibold"
              >
                Forgot Password?
              </a>
            </div>

            <!-- Login Button -->
            <button
              type="submit"
              class="w-full bg-yellow-500 hover:bg-yellow-600 text-slate-900 font-bold py-3 rounded-lg shadow-md transition"
            >
              LOGIN
            </button>

          </form>

          <div class="mt-7 border-t border-gray-200 pt-5 text-center">
            <p class="text-xs text-gray-500">
              Authorized personnel only.
            </p>
          </div>

        </div>
      </div>

      <!-- Footer -->
      <div class="text-center mt-6">
        <p class="text-xs text-gray-500">
          © 2026 StaffPay | RestoFlow System
        </p>

        <p class="text-xs text-gray-400 mt-1">
          Powered by XianFire Framework
        </p>
      </div>

    </div>
  </div>

  <!-- Show / Hide Password -->
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const passwordInput = document.getElementById("password");
      const toggleButton = document.getElementById("togglePassword");

      if (passwordInput && toggleButton) {
        toggleButton.addEventListener("click", function () {
          if (passwordInput.type === "password") {
            passwordInput.type = "text";
            toggleButton.textContent = "Hide";
          } else {
            passwordInput.type = "password";
            toggleButton.textContent = "Show";
          }
        });
      }
    });
  </script>

{{> footer }}