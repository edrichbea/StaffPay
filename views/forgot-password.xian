{{> head}}

<body class="min-h-screen bg-gray-100">

  <div class="min-h-screen flex items-center justify-center px-4 py-10">

    <div class="w-full max-w-lg">

      <!-- HEADER -->
      <div class="text-center mb-8">

        <div class="inline-flex items-center justify-center w-16 h-16 bg-yellow-500 rounded-2xl mb-4">
          <span class="text-3xl font-bold text-slate-900">S</span>
        </div>

        <h1 class="text-3xl font-extrabold text-slate-900">
          Staff<span class="text-yellow-600">Pay</span>
        </h1>

        <p class="text-sm text-gray-500 mt-2">
          Password Recovery
        </p>

      </div>

      <!-- RECOVERY CARD -->
      <div class="bg-white rounded-2xl shadow-xl border border-gray-200 overflow-hidden">

        <div class="bg-slate-900 px-8 py-6 text-center">

          <h2 class="text-2xl font-bold text-white">
            Forgot Password?
          </h2>

          <p class="text-sm text-gray-300 mt-2">
            Recover your account using your registered recovery email.
          </p>

        </div>

        <div class="p-8">

          <!-- EMAIL OTP -->
          <div class="border border-gray-200 rounded-xl p-6">

            <div class="flex items-center gap-3 mb-3">

              <div class="w-11 h-11 bg-yellow-100 rounded-lg flex items-center justify-center">
                <span class="text-2xl">✉</span>
              </div>

              <h3 class="font-bold text-slate-900 text-lg">
                Email Verification
              </h3>

            </div>

            <p class="text-sm text-gray-600 mb-5">
              Receive a one-time password (OTP) through your registered recovery email to securely reset your password.
            </p>

            <a
              href="/forgot-password/email"
              class="block text-center bg-yellow-500 hover:bg-yellow-600 text-slate-900 font-bold py-3 rounded-lg transition"
            >
              Continue with Email
            </a>

          </div>

          <!-- SECURITY NOTE -->
          <div class="mt-6 bg-slate-50 border border-slate-200 rounded-xl p-4">

            <p class="text-sm text-slate-700 font-semibold mb-1">
              <span class="text-yellow-600">🔒</span> Account Security
            </p>

            <p class="text-xs text-gray-500 leading-relaxed">
              Your password can only be changed after successful email verification. Never share your OTP with anyone.
            </p>

          </div>

          <!-- BACK TO LOGIN -->
          <div class="text-center mt-7">

            <a
              href="/login"
              class="text-sm text-yellow-700 font-semibold hover:text-yellow-800"
            >
              ← Back to Login
            </a>

          </div>

        </div>

      </div>

      <!-- FOOTER -->
      <div class="text-center mt-6">
        <p class="text-xs text-gray-500">
          © 2026 StaffPay | RestoFlow System
        </p>
      </div>

    </div>

  </div>

{{> footer }}